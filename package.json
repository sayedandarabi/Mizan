{
  "name": "hesab-afghanistan",
  "version": "6.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:prepare": "expo prebuild --platform android",
    "android:debug": "expo prebuild --platform android && cd android && gradlew.bat assembleDebug",
    "android:release": "expo prebuild --platform android && cd android && gradlew.bat assembleRelease",
    "check:env": "node tools/check-env.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.57.0",
    "decimal.js": "^10.6.0",
    "expo": "~54.0.0",
    "expo-sqlite": "~16.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
